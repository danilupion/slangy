{
  "name": "@slangy/config",
  "version": "1.0.0",
  "author": {
    "name": "Dani Lupión",
    "email": "danilupion@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "build:watch": "rm -rf ./dist && tsc --watch",
    "build:check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "config": "^3.3.11"
  },
  "peerDependencies": {
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@slangy-config/eslint": "workspace:*",
    "@slangy-config/lint-staged": "workspace:*",
    "@slangy-config/typescript": "workspace:*",
    "@types/config": "^3.3.4"
  }
}
