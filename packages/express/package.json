    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "@slangy/config": "workspace:*",
    "chalk": "^5.3.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@slangy-config/eslint": "workspace:*",
    "@slangy-config/lint-staged": "workspace:*",
    "@slangy-config/typescript": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.11"
  }
}
