{
  "name": "@slangy/http",
  "version": "1.0.0",
  "author": {
    "name": "Dani Lupión",
    "email": "danilupion@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "build:watch": "rm -rf ./dist && tsc --watch",
    "build:check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "http-status-codes": "^2.3.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@slangy-config/eslint": "workspace:*",
    "@slangy-config/lint-staged": "workspace:*",
    "@slangy-config/typescript": "workspace:*",
    "@types/node": "^20.14.2"
  }
}
